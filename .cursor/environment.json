{
  "name": "RelayAPI",
  "install": "./.cursor/install.sh",
  "start": "./.cursor/start.sh",
  "terminals": [
    {
      "name": "relayapi backend",
      "command": "DATABASE_URL='postgres://relay:relay@127.0.0.1:5432/relay?sslmode=disable' RELAY_SESSION_SECRET='relay-dev-session-secret-0123456789abcdef' RELAY_API_KEY_ENCRYPTION_KEY='relay-dev-encryption-key-0123456789abcdef' RELAY_PUBLIC_URL='http://localhost:3000' go run ./cmd/relayapi"
    },
    {
      "name": "web dev server",
      "command": "cd web && pnpm dev --host"
    }
  ],
  "ports": [
    { "name": "relayapi backend", "port": 3000 },
    { "name": "web dev server", "port": 5173 }
  ]
}
