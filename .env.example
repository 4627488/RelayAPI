# Required secrets: set real values in .env; no defaults are committed.
POSTGRES_PASSWORD=
DATABASE_URL=
RELAY_SESSION_SECRET=
RELAY_API_KEY_ENCRYPTION_KEY=

# Embedded CPA plus Relay admission. Process bounds (timeout, request body,
# in-flight memory, reclaim, unpriced models, WebSockets) and CPA executor
# knobs are hot-edited in 运行策略. These env values only seed a missing
# store row. Optional one-shot import from a CPA auth directory:
# RELAY_CPA_IMPORT_AUTH_DIR=
# RELAY_CPA_IMPORT_CONFIG=
RELAY_MAX_IN_FLIGHT=8
RELAY_MAX_QUEUE=16
RELAY_QUEUE_TIMEOUT_MILLISECONDS=2000
RELAY_MAX_REQUEST_MIB=1024
RELAY_REQUEST_BYTES_IN_FLIGHT_MIB=8192
RELAY_REQUEST_TIMEOUT_SECONDS=86400
# 0 disables the process-wide circuit breaker. Credential isolation stays in
# the admin 运行策略 form.
RELAY_CIRCUIT_FAILURE_THRESHOLD=0
RELAY_CIRCUIT_OPEN_SECONDS=15
RELAY_QUOTA_SYNC_INTERVAL_SECONDS=300
# Preserve native Codex/xAI WebSocket sessions. Operators can toggle this
# from 运行策略 without restart.
RELAY_UPSTREAM_WEBSOCKETS=true

# Native runtime memory envelope.
RELAY_GOMEMLIMIT=448MiB
RELAY_MEMORY_LIMIT=768m
RELAY_MEMORY_RESERVATION=384m
RELAY_MEMORY_RECLAIM_THRESHOLD_MIB=8192
RELAY_BIND_ADDRESS=0.0.0.0
RELAY_PORT=8080

POSTGRES_MEMORY_LIMIT=768m
POSTGRES_SHM_SIZE=64m
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=96MB
POSTGRES_VOLUME_NAME=relayapi-postgres

RELAY_PUBLIC_URL=http://localhost:8080
# Directory of rai-<os>-<arch> binaries served at /rai/download. The
# published image sets this to /rai-bin. Empty for a local go run.
# RELAY_RAI_BIN_DIR=
RELAY_SECURE_COOKIES=false
UNPRICED_MODEL_POLICY=allow
REQUEST_LOG_RETENTION_DAYS=30
REQUEST_LOG_DETAIL_RETENTION_DAYS=14
REQUEST_LOG_SUCCESS_DETAIL_DAYS=1
# Successful requests retain structured summaries only. Error bodies are
# bounded to 32 KiB; set a non-zero PPM only for temporary diagnostics.
REQUEST_LOG_SUCCESS_SAMPLE_PPM=0
RELAY_LIFECYCLE_SUCCESS_HOURS=24
RELAY_LIFECYCLE_ERROR_DAYS=7
REQUEST_RESERVATION_RETENTION_DAYS=14
INCOMPLETE_RESERVATION_RETENTION_DAYS=90
QUOTA_OBSERVATION_RETENTION_DAYS=180
INVITATION_RETENTION_DAYS=30
RETENTION_BATCH_SIZE=5000
RETENTION_MAX_RUNTIME_SECONDS=30
BILLING_RESERVE_NANO_USD=10000000
BILLING_IMAGE_RESERVE_NANO_USD=500000000
