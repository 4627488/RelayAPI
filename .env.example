DATABASE_URL=postgres://relay:change-me@postgres:5432/relay?sslmode=disable
CPA_URL=http://cliproxyapi:8317
CPA_API_KEY=change-me
CPA_MANAGEMENT_KEY=
# Required when relayapi-bridge or parent/child subscriptions are enabled.
CPA_PLUGIN_SECRET=change-this-plugin-shared-secret
# Poll normalized credential quota through the CPA bridge (minimum 60 seconds).
CPA_QUOTA_SYNC_INTERVAL_SECONDS=300
RELAY_SESSION_SECRET=change-this-session-secret-at-least-32-characters
RELAY_PUBLIC_URL=http://localhost:8080
RELAY_SECURE_COOKIES=false
UNPRICED_MODEL_POLICY=allow
REQUEST_LOG_RETENTION_DAYS=30
# Error and incomplete request details. Successful details use the shorter window below.
REQUEST_LOG_DETAIL_RETENTION_DAYS=14
REQUEST_LOG_SUCCESS_DETAIL_DAYS=1
# Deterministic 1% sample of successful, fully-priced requests (parts per million).
REQUEST_LOG_SUCCESS_SAMPLE_PPM=10000
CPA_LIFECYCLE_SUCCESS_HOURS=24
CPA_LIFECYCLE_ERROR_DAYS=7
REQUEST_RESERVATION_RETENTION_DAYS=14
INCOMPLETE_RESERVATION_RETENTION_DAYS=90
QUOTA_OBSERVATION_RETENTION_DAYS=180
INVITATION_RETENTION_DAYS=30
RETENTION_BATCH_SIZE=5000
RETENTION_MAX_RUNTIME_SECONDS=30
BILLING_RESERVE_NANO_USD=10000000
