# Required secrets: set real values in .env; no defaults are committed.
POSTGRES_PASSWORD=
DATABASE_URL=
RELAY_SESSION_SECRET=
RELAY_API_KEY_ENCRYPTION_KEY=

# Embedded CPA admission and transport limits.
CPA_MAX_IN_FLIGHT=16
CPA_MAX_QUEUE=32
CPA_QUEUE_TIMEOUT_MILLISECONDS=2000
CPA_MAX_REQUEST_MIB=16
CPA_REQUEST_BYTES_IN_FLIGHT_MIB=32
CPA_REQUEST_TIMEOUT_SECONDS=600
CPA_CIRCUIT_FAILURE_THRESHOLD=3
CPA_CIRCUIT_OPEN_SECONDS=15
CPA_QUOTA_SYNC_INTERVAL_SECONDS=300

# Embedded executor memory envelope.
RELAY_GOMEMLIMIT=576MiB
RELAY_MEMORY_LIMIT=768m
RELAY_MEMORY_RESERVATION=512m
RELAY_EXECUTOR_CACHE_PRESSURE_MIB=384
RELAY_BIND_ADDRESS=0.0.0.0
RELAY_PORT=8080

POSTGRES_MEMORY_LIMIT=768m
POSTGRES_SHM_SIZE=64m
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=96MB
POSTGRES_VOLUME_NAME=relayapi-postgres

RELAY_PUBLIC_URL=http://localhost:8080
RELAY_SECURE_COOKIES=false
UNPRICED_MODEL_POLICY=allow
REQUEST_LOG_RETENTION_DAYS=30
REQUEST_LOG_DETAIL_RETENTION_DAYS=14
REQUEST_LOG_SUCCESS_DETAIL_DAYS=1
REQUEST_LOG_SUCCESS_SAMPLE_PPM=10000
CPA_LIFECYCLE_SUCCESS_HOURS=24
CPA_LIFECYCLE_ERROR_DAYS=7
REQUEST_RESERVATION_RETENTION_DAYS=14
INCOMPLETE_RESERVATION_RETENTION_DAYS=90
QUOTA_OBSERVATION_RETENTION_DAYS=180
INVITATION_RETENTION_DAYS=30
RETENTION_BATCH_SIZE=5000
RETENTION_MAX_RUNTIME_SECONDS=30
BILLING_RESERVE_NANO_USD=10000000
