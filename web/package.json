    "@stylexjs/stylex": "^0.19.0",
    "lucide-react": "^1.26.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "3.8.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@astryxdesign/cli",
      "@astryxdesign/core"
